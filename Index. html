                    <button onclick="switchTab('scouting')" id="nav-scouting" class="nav-btn px-4 py-2 rounded-lg text-sm font-medium text-gray-300 hover:text-white hover:bg-brand-blue/10 transition-all">
                        <i class="fa-solid fa-binoculars mr-1.5 text-xs"></i> Scouting
                    </button>
                    <button onclick="switchTab('contact')" id="nav-contact" class="nav-btn px-4 py-2 rounded-lg text-sm font-medium text-gray-300 hover:text-white hover:bg-brand-blue/10 transition-all">
