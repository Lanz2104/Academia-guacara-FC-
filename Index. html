            <button onclick="switchTab('home')" class="w-full text-left px-3 py-2 rounded-md text-base font-medium text-white hover:bg-brand-blue/20">Inicio</button>
            <button onclick="switchTab('institution')" class="w-full text-left px-3 py-2 rounded-md text-base font-medium text-gray-300 hover:bg-brand-blue/20">Quiénes Somos</button>
            <button onclick="switchTab('categories')" class="w-full text-left px-3 py-2 rounded-md text-base font-medium text-gray-300 hover:bg-brand-blue/20">Categorías y Planteles</button>
