                </nav>

                <!-- Action Button & Mobile Toggle -->
                <div class="flex items-center space-x-3">
                    <button onclick="switchTab('admissions')" class="hidden sm:inline-flex items-center px-4 py-2 rounded-lg text-xs font-bold uppercase tracking-wider bg-gradient-to-r from-brand-gold to-yellow-600 text-brand-darker hover:brightness-110 transition-all shadow-md shadow-brand-gold/20">
